{
  "name": "dropvault",
  "private": true,
  "version": "0.1.0",
  "description": "Dropvault — a friends-only mini Google Drive with auto-expiring files, built entirely on Cloudflare.",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev:web": "pnpm --filter @dropvault/web dev",
    "dev:api": "pnpm --filter @dropvault/api dev",
    "build": "pnpm --filter @dropvault/web build",
    "deploy:api": "pnpm --filter @dropvault/api run deploy",
    "db:generate": "pnpm --filter @dropvault/api db:generate",
    "db:migrate:local": "pnpm --filter @dropvault/api db:migrate:local",
    "db:migrate:remote": "pnpm --filter @dropvault/api db:migrate:remote",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @dropvault/web test:e2e",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "audit:prod": "pnpm audit --prod --audit-level high"
  }
}
